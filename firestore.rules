rules_version = '2';

// ============================================================================
//  Reglas de seguridad de Firestore
//
//  Cómo usar:
//  1. Ve a Firebase Console -> Firestore Database -> pestaña "Reglas"
//  2. Pega TODO este archivo (reemplaza lo que haya)
//  3. Click en "Publicar"
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -- businesses/{uid} ----------------------------------------------------
    // Cada admin (autenticado por Google) tiene un documento con sus
    // settings. CUALQUIERA puede leer ese documento (es el cliente
    // que abre el link público y ve el nombre del negocio, horarios, etc).
    // Solo el dueño puede escribir.
    match /businesses/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      // -- citas (subcolección) --------------------------------------------
      // - CUALQUIERA puede CREAR una cita (es lo que hace el cliente
      //   cuando rellena el formulario público).
      // - Solo el dueño del negocio puede LEER, ACTUALIZAR o BORRAR.
      match /citas/{citaId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if isCitaValida();
        allow update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Validacion basica de la cita que crea un cliente publico.
    function isCitaValida() {
      let d = request.resource.data;
      return d.nombre is string && d.nombre.size() > 0 && d.nombre.size() < 200
        && d.email is string && d.email.matches('[^@\\s]+@[^@\\s]+\\.[^@\\s]+')
        && d.telefono is string && d.telefono.size() > 0 && d.telefono.size() < 50
        && d.fecha is string && d.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.hora is string && d.hora.matches('[0-9]{2}:[0-9]{2}')
        && d.estado == 'pendiente';
    }
  }
}
